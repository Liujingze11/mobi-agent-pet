{
  "name": "agentlog-pet",
  "productName": "AgentLog Pet",
  "desktopName": "agentlog-pet.desktop",
  "version": "0.1.0",
  "description": "Your Private AI Agent Work Journal",
  "author": "Liujingze11",
  "homepage": "https://github.com/Liujingze11/agentlog-pet",
  "main": "runtime/agentlog/main.cjs",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "npm run build:manager && node runtime/clawd/scripts/ensure-sidecar-binaries.js && node scripts/launch-electron.cjs",
    "dev": "npm run build:manager && CLAWD_SKIP_SIDECAR_FETCH=1 node scripts/launch-electron.cjs",
    "fetch:sidecars": "node runtime/clawd/scripts/fetch-sidecar-binaries.js",
    "verify:sidecars": "node runtime/clawd/scripts/verify-sidecar-binaries.js",
    "test": "node --test test/agentlog/*.test.cjs",
    "test:manager": "vitest run --config vitest.manager.config.ts",
    "typecheck:manager": "tsc -p tsconfig.manager.json --noEmit",
    "test:upstream": "node runtime/clawd/test/run-tests.js",
    "test:phase1": "npm test && npm run test:upstream",
    "test:phase2": "npm test && npm run test:manager && npm run typecheck:manager && npm run build:manager && npm run test:upstream",
    "build:manager": "vite build --config vite.manager.config.ts",
    "prebuild:linux": "npm run build:manager && node runtime/clawd/scripts/verify-sidecar-binaries.js build:linux && node scripts/build-linux-tray-helper.cjs && node scripts/verify-linux-tray-bundle.cjs build/tray",
    "build:linux": "node scripts/build-linux.cjs",
    "smoke:linux": "node scripts/smoke-linux.cjs",
    "smoke:manager": "node scripts/smoke-manager.cjs",
    "postinstall": "node scripts/verify-electron-install.cjs --context postinstall"
  },
  "dependencies": {
    "@larksuiteoapi/node-sdk": "^1.71.1",
    "better-sqlite3": "12.11.1",
    "electron-updater": "^6.8.3",
    "htmlparser2": "^12.0.0",
    "jsonc-parser": "^3.3.1",
    "koffi": "^2.15.2",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/better-sqlite3": "^7.6.12",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "electron": "^41.10.2",
    "electron-builder": "^26.8.1",
    "jsdom": "26.1.0",
    "lucide-react": "^0.460.0",
    "postcss": "^8.4.49",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^2.13.0",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vite-plugin-electron": "^0.28.0",
    "vite-plugin-electron-renderer": "^0.14.0",
    "vitest": "3.2.4",
    "wait-on": "^8.0.0"
  },
  "build": {
    "appId": "com.agentlog.pet",
    "productName": "AgentLog Pet",
    "npmRebuild": false,
    "directories": {
      "output": "Linux",
      "buildResources": "runtime/clawd/build"
    },
    "protocols": [
      {
        "name": "AgentLog Pet Import Protocol",
        "schemes": ["clawd"]
      }
    ],
    "files": [
      "package.json",
      "dist/manager/**/*",
      "runtime/agentlog/**/*",
      "assets/brand/**/*",
      "runtime/clawd/package.json",
      "runtime/clawd/NOTICE.md",
      "runtime/clawd/AGENTLOG_UPSTREAM.json",
      "runtime/clawd/src/**/*",
      "runtime/clawd/assets/**/*",
      "runtime/clawd/hooks/**/*",
      "runtime/clawd/extensions/**/*",
      "runtime/clawd/agents/**/*",
      "runtime/clawd/themes/**/*",
      "runtime/clawd/pwa/**/*"
    ],
    "asarUnpack": [
      "runtime/clawd/assets/svg/**/*",
      "runtime/clawd/assets/accessories/**/*",
      "runtime/clawd/hooks/**/*",
      "runtime/clawd/extensions/**/*",
      "runtime/clawd/agents/**/*",
      "runtime/clawd/themes/**/*",
      "node_modules/jsonc-parser/**/*",
      "node_modules/better-sqlite3/**/*"
    ],
    "linux": {
      "maintainer": "Liujingze11",
      "icon": "assets/brand/icons",
      "category": "Development",
      "syncDesktopName": true,
      "artifactName": "AgentLog-Pet-${version}-x64.${ext}",
      "target": [
        { "target": "AppImage", "arch": ["x64"] },
        { "target": "deb", "arch": ["x64"] }
      ],
      "extraResources": [
        {
          "from": "runtime/clawd/bin/cc-connect-clawd/linux-${arch}",
          "to": "sidecars/cc-connect-clawd/linux-${arch}"
        },
        {
          "from": "build/tray",
          "to": "tray"
        }
      ]
    },
    "deb": {
      "depends": [
        "libgtk-3-0 | libgtk-3-0t64",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0",
        "libayatana-appindicator3-1",
        "libjson-glib-1.0-0"
      ]
    },
    "extraResources": [
      {
        "from": "assets/brand/icon.png",
        "to": "icon.png"
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "Liujingze11",
        "repo": "agentlog-pet"
      }
    ]
  }
}
